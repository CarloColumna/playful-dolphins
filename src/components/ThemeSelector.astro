---
const themes = [
  { id: "lofi",      label: "lofi",      colors: ["#0d0d0d", "#1a1a1a", "#f2f2f2", "#e6e6e6"] },
  { id: "dolphin",   label: "dolphin",   colors: ["#4dd2ff", "#39f3bb", "#1a2438", "#273550"] },
  { id: "dark",      label: "dark",      colors: ["#7c3aed", "#d926aa", "#191e24", "#2a323c"] },
  { id: "cupcake",   label: "cupcake",   colors: ["#65c3c8", "#ef9fbc", "#efeae6", "#e7e2dd"] },
  { id: "synthwave", label: "synthwave", colors: ["#e779c1", "#58c7f3", "#241555", "#3d2882"] },
  { id: "retro",     label: "retro",     colors: ["#ef9995", "#a4cbb4", "#d8cca0", "#c9bb89"] },
  { id: "cyberpunk", label: "cyberpunk", colors: ["#ff7598", "#75d1f0", "#facc15", "#d4b412"] },
  { id: "valentine", label: "valentine", colors: ["#e96d7b", "#a991f7", "#ebc6dd", "#e2bcd5"] },
  { id: "aqua",      label: "aqua",      colors: ["#09ecf3", "#ffe999", "#2c4f8f", "#4870b7"] },
  { id: "forest",    label: "forest",    colors: ["#1eb854", "#1fd65f", "#1f1818", "#2a2425"] },
  { id: "dracula",   label: "dracula",   colors: ["#ff79c6", "#bd93f9", "#1e1f29", "#44475a"] },
  { id: "night",     label: "night",     colors: ["#38bdf8", "#818cf8", "#1a2238", "#2a3957"] },
  { id: "coffee",    label: "coffee",    colors: ["#db924b", "#c47238", "#2a1e29", "#3a2c39"] },
  { id: "winter",    label: "winter",    colors: ["#047aff", "#463aa2", "#f3f4f6", "#d1d5db"] },
];
---

<div class="theme-selector" id="theme-selector">
  <button class="theme-toggle" id="theme-toggle" aria-label="Change theme" aria-haspopup="true" aria-expanded="false">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/>
    </svg>
    <span>Theme</span>
    <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="currentColor" class="chev">
      <path d="M7 10l5 5 5-5z"/>
    </svg>
  </button>

  <div class="theme-menu" id="theme-menu" role="menu">
    {themes.map((t) => (
      <button class="theme-item" data-theme-set={t.id} role="menuitem">
        <span class="theme-name">{t.label}</span>
        <span class="theme-swatches">
          {t.colors.map((c) => <span class="swatch" style={`background:${c}`} />)}
        </span>
      </button>
    ))}
  </div>
</div>

<script is:inline>
  (function () {
    const KEY = "data-theme";
    const DEFAULT = "lofi";

    function applyTheme(name) {
      document.documentElement.setAttribute("data-theme", name);
      try { localStorage.setItem(KEY, name); } catch (e) {}
      document.querySelectorAll("#theme-selector .theme-item").forEach((el) => {
        el.classList.toggle("active", el.getAttribute("data-theme-set") === name);
      });
    }

    function init() {
      let stored = DEFAULT;
      try { stored = localStorage.getItem(KEY) || DEFAULT; } catch (e) {}
      applyTheme(stored);

      const toggle = document.getElementById("theme-toggle");
      const menu = document.getElementById("theme-menu");
      const sel = document.getElementById("theme-selector");
      if (!toggle || !menu || !sel) return;

      toggle.addEventListener("click", (e) => {
        e.stopPropagation();
        const open = sel.classList.toggle("open");
        toggle.setAttribute("aria-expanded", String(open));
      });
      document.addEventListener("click", (e) => {
        if (!sel.contains(e.target)) {
          sel.classList.remove("open");
          toggle.setAttribute("aria-expanded", "false");
        }
      });
      menu.querySelectorAll(".theme-item").forEach((btn) => {
        btn.addEventListener("click", () => {
          applyTheme(btn.getAttribute("data-theme-set"));
          sel.classList.remove("open");
          toggle.setAttribute("aria-expanded", "false");
        });
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  })();
</script>
