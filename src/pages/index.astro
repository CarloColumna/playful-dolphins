---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { site } from "../data/site";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const posts: CollectionEntry<"blog">[] = (
  await getCollection("blog", ({ data }: CollectionEntry<"blog">) => !data.draft)
).sort(
  (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
    b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const lastPosts = posts.slice(0, 3);

const projects: CollectionEntry<"projects">[] = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const featured = projects.filter((p) => p.data.featured).slice(0, 3);
const featuredList = featured.length ? featured : projects.slice(0, 3);
---

<BaseLayout active="home" title={`${site.name} | ${site.role}`} description={site.summary}>
  <section class="card hero">
    <span class="badge">AWS Community Builder &bull; Wellington, NZ 🇳🇿</span>
    <p class="greeting">Kia ora! 👋🏽</p>
    <h1>I'm {site.name}</h1>
    <p class="subtitle">{site.role}</p>
    <p>{site.summary}</p>
    <div class="cta">
      <a class="btn primary" href="/projects">View Projects</a>
      <a class="btn" href="/contact">Let's connect!</a>
      <a class="btn" href={site.social.github} target="_blank" rel="noreferrer">GitHub</a>
    </div>
  </section>

  <h2 class="section-title">Featured projects {`</>`}</h2>
  {featuredList.map((p) => (
    <HorizontalCard
      title={p.data.title}
      desc={p.data.summary}
      url={p.data.demo || p.data.repo}
      external={Boolean(p.data.demo || p.data.repo)}
      badge={p.data.featured ? "Featured" : undefined}
      tags={p.data.tech}
    />
  ))}

  {lastPosts.length > 0 && (
    <>
      <h2 class="section-title">Latest from blog</h2>
      {lastPosts.map((post) => (
        <HorizontalCard
          title={post.data.title}
          desc={post.data.description}
          url={post.data.externalUrl || `/blog/${post.slug}/`}
          external={Boolean(post.data.externalUrl)}
          meta={post.data.publishedAt.toISOString().slice(0, 10)}
          tags={post.data.tags}
        />
      ))}
    </>
  )}
</BaseLayout>
