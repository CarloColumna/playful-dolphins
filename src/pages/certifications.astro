---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const certs: CollectionEntry<"certifications">[] = (
  await getCollection("certifications")
).sort(
  (a: CollectionEntry<"certifications">, b: CollectionEntry<"certifications">) =>
    a.data.order - b.data.order,
);
---

<BaseLayout active="certifications" title="Certifications" description="Professional certifications and credentials">
  <section class="card container">
    <h1>Certifications</h1>
    <div class="grid">
      {
        certs.map((cert) => (
          <article class="card">
            <h2>{cert.data.title}</h2>
            <p>{cert.data.issuer} · Issued {cert.data.issued}</p>
            {cert.data.credentialId && <p><strong>Credential ID:</strong> {cert.data.credentialId}</p>}
            {cert.data.verifyUrl && (
              <a class="btn" href={cert.data.verifyUrl} target="_blank" rel="noreferrer">Verify</a>
            )}
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
