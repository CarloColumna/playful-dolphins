---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout active="about" title="About" description="Background and profile">
  <section class="card container">
    <h1>About</h1>
    <p>{site.summary}</p>
    <p>
      I write about cloud-native technologies, platform engineering, and real-world DevOps on
      <a href={site.social.medium} target="_blank" rel="noreferrer">Medium</a>.
      I'm also an <strong>AWS Community Builder</strong>, actively sharing knowledge across
      the community.
    </p>
    <p>
      Before IT, I spent four and a half years as a brewing engineer at San Miguel Corporation
      in the Philippines. I hold a Bachelor of Engineering in Chemical Engineering from the
      University of Santo Tomas, where I graduated Cum Laude.
    </p>
    <div>
      <a class="btn primary" href="/experience">View Experience</a>
      <a class="btn" href={site.social.linkedin} target="_blank" rel="noreferrer" style="margin-left: 0.6rem;">LinkedIn</a>
      <a class="btn" href={site.social.medium} target="_blank" rel="noreferrer" style="margin-left: 0.6rem;">Medium</a>
    </div>
  </section>
</BaseLayout>
