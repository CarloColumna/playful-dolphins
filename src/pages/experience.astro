---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const items: CollectionEntry<"experience">[] = (await getCollection("experience")).sort(
  (a: CollectionEntry<"experience">, b: CollectionEntry<"experience">) =>
    a.data.order - b.data.order,
);
---

<BaseLayout active="experience" title="Experience" description="Career timeline and impact">
  <section class="card container">
    <h1>Experience</h1>
    <div class="grid">
      {
        items.map((item) => (
          <article class="card">
            <div class="section-header">
              <h2>{item.data.role}</h2>
              <span class="badge">{item.data.start} - {item.data.end}</span>
            </div>
            <p>{item.data.company} · {item.data.location}</p>
            <ul>
              {(item.data.highlights as string[]).map((point) => <li>{point}</li>)}
            </ul>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
